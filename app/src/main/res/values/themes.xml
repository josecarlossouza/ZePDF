<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema principal -->
    <style name="Theme.ZePDF" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/red_primary</item>
        <item name="colorPrimaryDark">@color/red_primary_dark</item>
        <item name="colorSecondary">@color/red_accent</item>

        <!-- Força o popup menu (overflow) a usar tema CLARO -->
        <item name="popupTheme">@style/ThemeOverlay.ZePDF.PopupLight</item>
    </style>

    <!-- Tema claro específico para popup menus -->
    <style name="ThemeOverlay.ZePDF.PopupLight" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@android:color/black</item>
    </style>

</resources>